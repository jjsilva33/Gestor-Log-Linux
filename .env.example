# Copie para .env e preencha com valores reais antes de subir o docker compose.
# NUNCA commite o .env (já está no .gitignore).

DB_ROOT_PASSWORD=troque-esta-senha-root
DB_NAME=Syslog
DB_USER=gestorlog
DB_PASSWORD=troque-esta-senha

# Token do endpoint que recebe o mapeamento NAT do Mikrotik
# (site/gestorserver/nat/receiver.php). Gere com: openssl rand -hex 32
NAT_RECEIVER_TOKEN=troque-este-token

# --- Portainer + Traefik ---
# Domínio público do painel (o Traefik usa isso pra rotear e emitir o certificado)
DOMAIN=log.seudominio.com.br

# Nome da network externa do Traefik já criada no Portainer.
# Confira com: docker network ls | grep -i traefik
TRAEFIK_NETWORK=traefik

# Nome do certresolver configurado na stack do Traefik
# (procure por "certificatesresolvers" nas labels/command do próprio Traefik)
TRAEFIK_CERTRESOLVER=letsencrypt
